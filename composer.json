{
	"$schema": "https://getcomposer.org/schema.json",
	"name": "stilling/minecraft-rcon",
	"description": "Lightweight PHP client for Minecraft RCON with support for multi-packet responses longer than 4096 bytes.",
	"keywords": ["minecraft", "rcon", "rcon client", "minecraft server", "source rcon", "remote console", "multi-packet", "large responses"],
	"homepage": "https://github.com/m-stilling/minecraft-rcon-php",
	"license": "MIT",
	"authors": [
		{
			"name": "Michael Stilling"
		}
	],
	"support": {
		"issues": "https://github.com/m-stilling/minecraft-rcon-php/issues",
		"source": "https://github.com/m-stilling/minecraft-rcon-php"
	},
	"require": {
		"php": "^8.3"
	},
	"require-dev": {
		"pestphp/pest": "^4.0 || ^5.0",
		"phpstan/phpstan": "^2.2"
	},
	"autoload": {
		"psr-4": {
			"Stilling\\MinecraftRcon\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "pest",
		"analyse": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
